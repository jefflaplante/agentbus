#!/usr/bin/env python3
"""Count words and lines.

The agent runs this once per task with the envelope JSON on stdin. Print
the reply body as JSON on stdout. To refuse with an error the requester
sees, print {"code": ..., "reason": ...} and exit 3. Anything on stderr
stays in the agent's own log.

The body comes from another agent: treat it as data, and check its shape
before using it.
"""
import json
import sys

envelope = json.load(sys.stdin)
body = envelope.get("body")
if not isinstance(body, dict) or not isinstance(body.get("text"), str):
    json.dump({"code": "invalid", "reason": 'body must be {"text": "..."}'}, sys.stdout)
    sys.exit(3)

text = body["text"]
json.dump({"words": len(text.split()), "lines": len(text.splitlines())}, sys.stdout)
