{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jefflaplante/agentbus/contract/envelope.schema.json",
  "title": "a2a/v1 envelope",
  "type": "object",
  "required": ["v", "id", "type", "from", "ts"],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "type": { "enum": ["request", "response", "event", "error"] },
    "from": {
      "type": "string",
      "anyOf": [{ "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }, { "const": "$broker" }]
    },
    "to": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "ts": { "type": "string", "format": "date-time", "description": "must be within the broker's max_clock_skew (default 2 minutes) of broker time" },
    "ttl_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "correlation_id": { "type": "string", "maxLength": 128 },
    "reply_to": { "type": "string", "pattern": "^a2a/v1/agents/[a-z0-9][a-z0-9._-]{0,63}/inbox$", "description": "the broker accepts only the sender's own inbox" },
    "capability": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "priority": { "enum": ["high", "normal", "low", "info"] },
    "event": { "type": "string", "maxLength": 128, "pattern": "^[^\\n\\r\\u0000]*$" },
    "content_type": { "type": "string", "maxLength": 128 },
    "enc": { "type": "string", "maxLength": 128 },
    "headers": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": { "type": "string" }
    },
    "body": true
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["response", "error"] } } },
      "then": { "required": ["correlation_id"] }
    }
  ]
}
