{
  "listen": "127.0.0.1:1883",
  "max_envelope_bytes": 262144,
  "rate_per_second": 20,
  "rate_burst": 50,
  "dedupe_window": "10m",
  "data_dir": "/var/lib/agentbus",
  "audit_file": "/var/log/agentbus/audit.jsonl",
  "agents": [
    {
      "id": "conduit-home",
      "token_sha256": "replace-with-output-of-agentbus-token-0000000000000000000000000",
      "send_to": ["*"]
    },
    {
      "id": "researcher",
      "token_sha256": "replace-with-output-of-agentbus-token-0000000000000000000000000",
      "capabilities": ["research", "summarize"]
    },
    {
      "id": "cli-ops",
      "token_sha256": "replace-with-output-of-agentbus-token-0000000000000000000000000",
      "send_to": ["conduit-home", "researcher"]
    },
    {
      "id": "explorer",
      "token_sha256": "replace-with-output-of-agentbus-token-0000000000000000000000000",
      "observer": true
    }
  ]
}
