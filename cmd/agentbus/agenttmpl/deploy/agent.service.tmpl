# systemd unit for the {{.Name}} agent.
#
#   sudo install -m 0755 {{.Name}}-linux-amd64 /usr/local/bin/{{.Name}}
#   sudo install -m 0600 -D {{.Name}}.token /etc/agentbus/{{.Name}}.token
#   sudo cp {{.Name}}.service /etc/systemd/system/ && sudo systemctl enable --now {{.Name}}
#
# The token reaches the agent as a systemd credential, readable only by the
# service, which runs as a throwaway user with a read-only view of the
# system. Loosen ProtectSystem, ProtectHome or add ReadWritePaths= if a
# handler needs to change things on the host.
[Unit]
Description=agentbus agent {{.Name}}
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/{{.Name}}
LoadCredential=token:/etc/agentbus/{{.Name}}.token
Environment=AGENTBUS_TOKEN_FILE=%d/token
# With llm: handlers, the model key too. Either as a credential, with
# api_key_file: /run/credentials/{{.Name}}.service/model-key in agent.yaml:
# LoadCredential=model-key:/etc/agentbus/{{.Name}}.model-key
# or as ANTHROPIC_API_KEY=... (or OPENAI_API_KEY) in a mode-0600 file:
# EnvironmentFile=/etc/agentbus/{{.Name}}.env
# Environment=AGENTBUS_URL=ssl://bus.example.com:8883
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
Restart=on-failure
RestartSec=5
# SIGTERM starts a drain (manifest drain:, default 30s); give it time.
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
